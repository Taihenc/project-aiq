{
  "name": "project-aiq-mvp",
  "version": "1.0.0",
  "description": "",
  "packageManager": "pnpm@8.15.6",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup": "bash scripts/setup.sh",
    "dev": "turbo run dev --parallel",
    "dev:app": "trap 'pnpm run stop:qdrant' EXIT INT TERM; pnpm run dev:qdrant && turbo run dev --filter=web --filter=backend --filter=data-ingestion --filter=embedding-service --parallel",
    "dev:qdrant": "docker run -d -p 6333:6333 -p 6334:6334 -v $(pwd)/services/embedding-service/qdrant_data:/qdrant/storage:z --name qdrant qdrant/qdrant && echo 'Qdrant started at http://localhost:6333/dashboard'",
    "stop:qdrant": "docker stop qdrant && docker rm qdrant",
    "dev:web": "turbo run dev --filter=web",
    "dev:backend": "turbo run dev --filter=backend",
    "dev:ai-engine": "turbo run dev --filter=ai-engine",
    "dev:embedding-service": "turbo run dev --filter=embedding-service",
    "dev:data-ingestion": "turbo run dev --filter=data-ingestion",
    "dev:sharepoint-webhook": "turbo run dev --filter=sharepoint-webhook",
    "dev:file-storage-service": "turbo run dev --filter=file-storage-service",
    "start": "turbo run start --parallel",
    "start:web": "turbo run start --filter=web",
    "start:backend": "turbo run start --filter=backend",
    "start:ai-engine": "turbo run start --filter=ai-engine",
    "start:embedding-service": "turbo run start --filter=embedding-service",
    "start:data-ingestion": "turbo run start --filter=data-ingestion",
    "start:sharepoint-webhook": "turbo run start --filter=sharepoint-webhook",
    "start:file-storage-service": "turbo run start --filter=file-storage-service",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "prepare": "husky",
    "clean": "turbo run clean"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.5.8"
  }
}