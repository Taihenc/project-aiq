NODE_ENV=development
PORT=3000

# Database (SQLite) - local uses ./sqlite.db, production uses /data/backend/sqlite.db
DATABASE_PATH=sqlite.db

# Service URLs (Docker network service names)
AI_ENGINE_BASE_URL=http://search-flow:8000
AI_SERVICE_BASE_URL=http://search-flow:8000
EMBEDDING_SERVICE_URL=http://embedding-service:8003
FILE_STORAGE_URL=http://file-storage-service:8004
SHAREPOINT_WEBHOOK_URL=http://sharepoint-webhook:8004

# CORS (Comma-separated origins)
# Allow the frontend origin(s) - add your production domain(s) here
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,http://127.0.0.1:3001

# JWT Authentication
# For local dev, this can be simple. For production, generate a strong random secret:
#   openssl rand -base64 64
JWT_SECRET=dev-secret-change-this-in-production-at-least-256-bits

# Logging
# Comma-separated log levels: log,error,warn,debug,verbose
LOG_LEVELS=log,error,warn,debug,verbose
