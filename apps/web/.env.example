NODE_ENV=development
PORT=3001

# In local dev with Docker Compose, backend is reachable at http://backend:3000
# When running outside Docker (localhost), use http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
INTERNAL_BACKEND_URL=http://backend:3000

# Demo Mode - set to false to hide demo banners/buttons
NEXT_PUBLIC_DEMO_MODE=false
