PYTHONUNBUFFERED=1

# API Configuration
# Local: embedding-service at container port 8003
API_URL=http://embedding-service:8003/v1/upload
MAX_CHUNK_SIZE=512
UPLOAD_DIR=uploaded-files
ENABLE_SHAREPOINT_INTEGRATION=false

# RabbitMQ Configuration (used for async event handling)
RABBITMQ_HOST=rabbitmq

# File Storage Service (MinIO via file-storage-service)
FILE_STORAGE_URL=http://file-storage-service:8004

# Embedding Service URL (for direct calls if needed)
EMBEDDING_SERVICE_URL=http://embedding-service:8003

# SSL Verification
# Set to false when running on company device with SSL inspection proxy
# Default (true) keeps SSL verification enabled
VERIFY_SSL=true
