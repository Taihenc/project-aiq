PYTHONUNBUFFERED=1

# Server configuration
# Note: PORT is not used by the application (port is fixed in Dockerfile), but kept for reference.
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Service URLs (Docker network service names)
EMBEDDING_SERVICE_URL=http://embedding-service:8003
MCP_SERVER_URL=http://embedding-service:8003/v1/mcp/sse

# CrewAI Configuration
CREW_VERBOSE=false
CREW_MAX_ITER=5
CREWAI_TRACING_ENABLED=false
CREWAI_STREAM=true
CREW_MAX_TOKENS=1500

# Search defaults
SEARCH_TOP_K=10
SEARCH_TOP_N=5

# HyDE (Hypothetical Document Embeddings)
CREW_HYDE_VERBOSE=true
CREW_HYDE_MAX_TOKENS=512
AZURE_HYDE_MODEL_NAME=gpt-4o-mini

# Azure OpenAI / Azure AI Foundry
# For local dev, you can use local LLM via Ollama or leave empty
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-12-01-preview
AZURE_MODEL_NAME=azure/gpt-4.1

# Langfuse Observability (Optional - leave empty for local)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Logging
# Comma-separated log levels (e.g., info,debug,warn,error)
LOG_LEVELS=info,debug,warn,error
