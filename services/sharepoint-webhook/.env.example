PYTHONUNBUFFERED=1
SERVER_PORT=8004

# File Storage Service (MinIO via file-storage-service)
FILE_STORAGE_URL=http://file-storage-service:8004

# Azure AD / Entra ID Configuration
# For local dev, leave empty or use test credentials
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# SharePoint Configuration
TENANT_NAME=
SITE_NAME=
LIST_NAME=Documents

# File Sync Configuration
ENABLE_SYNC=false  # Disable for local dev to avoid sync loops
SYNC_DIR=./synced_files

# Tunnel Configuration
# Local dev: "none" (no tunnel needed)
# Production: "none" (direct internet) or "cloudflare" if using tunnel
TUNNEL_TYPE=none

# Cloudflare Tunnel (if TUNNEL_TYPE=cloudflare)
CLOUDFLARE_TUNNEL_URL=

# Client state for OAuth flow
CLIENT_STATE=mySecretClientStateForTesting

# Logging
LOG_LEVEL=DEBUG
LOG_DIR=./logs
LOG_FILE=sharepoint-webhook.log
