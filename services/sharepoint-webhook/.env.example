# Azure AD / Entra ID Configuration
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# SharePoint Configuration
TENANT_NAME=your-tenant-name
SITE_NAME=your-site-name
LIST_NAME=Documents

# File Sync Configuration
# Enable/disable automatic file synchronization to local directory
ENABLE_SYNC=true
# Directory where files will be synced (default: ./synced_files)
SYNC_DIR=./synced_files

# Tunnel Configuration
# Options: "ngrok" or "cloudflare" (default: cloudflare)
TUNNEL_TYPE=cloudflare

# Ngrok Configuration (if TUNNEL_TYPE=ngrok)
# ngrok will be automatically initialized when you run the app!
# No need to start ngrok manually or set NGROK_URL unless you want to.

# Optional: Set ngrok auth token for additional features (custom domains, etc.)
# Get your auth token from: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=your_ngrok_auth_token_here

# Optional: Manually set ngrok URL if you prefer to run ngrok separately
# NGROK_URL=https://abc123.ngrok.io

# Cloudflare Configuration (if TUNNEL_TYPE=cloudflare)
# You MUST start cloudflared manually in a separate terminal:
# cloudflared tunnel --url http://localhost:8000
# Then copy the public URL here
CLOUDFLARE_TUNNEL_URL=https://your-tunnel.trycloudflare.com

# Logging Configuration
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO
# Directory where log files will be stored (default: ./logs)
LOG_DIR=./logs
# Optional: Specify a custom log file name (default: aingo-webhook-YYYYMMDD.log)
# LOG_FILE=custom-log.log

