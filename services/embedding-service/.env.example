PYTHONUNBUFFERED=1

# Qdrant Vector Database
# Local: qdrant service on port 6333
# Production: use Azure managed service or keep local in container
USE_LOCAL_QDRANT=true
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
COLLECTION_NAME=documents

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_SIZE=1024
BATCH_SIZE=32

# SSL Verification
# Set to false only for corporate proxy with SSL inspection
# For local dev with self-signed certs, keep true (no SSL in Docker network)
VERIFY_SSL=true

# Logging
# Local dev: DEBUG or INFO for more details
LOG_LEVEL=DEBUG
