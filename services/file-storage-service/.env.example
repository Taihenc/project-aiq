PYTHONUNBUFFERED=1

# Database (SQLite)
DB_PATH=file_metadata.db

# S3 / MinIO Configuration (local minio service)
S3_ENDPOINT=http://aingo-minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ingestion-bucket

# RabbitMQ Configuration (for async messaging)
RABBITMQ_HOST=rabbitmq

# Embedding Service URL (for triggering embeddings on upload)
EMBEDDING_SERVICE_URL=http://embedding-service:8003

# Backend Webhook URL (for sending file metadata to backend)
NESTJS_WEBHOOK_URL=http://backend:3000/api/file-storage/webhook
