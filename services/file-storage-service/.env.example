PYTHONUNBUFFERED=1

# Database
# Local: ./file_metadata.db (in project dir)
# Production: /data/file_metadata.db (on mounted disk)
DB_PATH=file_metadata.db

# S3 / MinIO Configuration
# Local: minio service on port 9000
S3_ENDPOINT=http://aingo-minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ingestion-bucket
S3_REGION=us-east-1

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Embedding Service URL (for triggering embeddings on upload)
EMBEDDING_SERVICE_URL=http://embedding-service:8003

# Backend Webhook URL (for sending file metadata to backend)
NESTJS_WEBHOOK_URL=http://backend:3000/api/file-storage/webhook

# Upload Settings
MAX_FILE_SIZE_MB=100
ALLOWED_FILE_EXTENSIONS=pdf,docx,txt,md,jpg,png

# Logging
# Local dev: DEBUG for verbose output
LOG_LEVEL=DEBUG
LOG_FILE=./file-storage-service.log

# Data Directory (for temporary files)
DATA_DIR=./temp
